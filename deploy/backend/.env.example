# Copy to .env on 172.28.92.57:  cp .env.example .env && nano .env

# Database connection. Self-managed values shown; for ApsaraDB RDS set DB_HOST to the
# instance endpoint, DB_PORT to its port, and DB_USER/DB_NAME to the RDS account and database.
DB_PASSWORD=CHANGE_ME
DB_HOST=172.28.92.60
DB_PORT=5443
DB_USER=bcapp
DB_NAME=bcinventory
# Prefer = use TLS when the server offers it. Set to Require to insist on it.
DB_SSLMODE=Prefer

# Whether the API may create and alter its own tables at startup.
# Leave true while DB_USER owns the tables. Set to FALSE once you switch DB_USER to the
# least-privilege role bcapp_rw (AR-06) — that role cannot alter the schema, and the API would
# fail to start trying. Apply schema changes then with the owner account; the overrides go in
# the SHELL, BEFORE the command (Compose reads ${DB_USER} from the file, so `run -e DB_USER=…`
# is too late and the run would still connect as the restricted role):
#   DB_USER=<owner> DB_PASSWORD=<owner pw> DB_AUTO_MIGRATE=true docker compose run --rm api --migrate
DB_AUTO_MIGRATE=true

# Where the API listens on the backend host. Bind to the private interface only (never 0.0.0.0);
# the frontend host connects to API_BIND:API_PORT. Pick a port that is free on this host.
API_BIND=172.28.92.57
API_PORT=8085

# JWT signing key — 32+ random characters. Changing it invalidates all sessions.
# Generate:  openssl rand -base64 48
JWT_KEY=CHANGE_ME

# How long a sign-in lasts, in minutes (default 120, maximum 720). A captured token is useful
# for exactly this long, so it is a security decision: shorter is safer, longer is friendlier.
JWT_LIFETIME_MINUTES=120

# Cross-origin access. The front end is served from the same origin as the API, so leave this
# empty. Set it (comma separated) only if a client is genuinely hosted elsewhere.
CORS_ORIGINS=

# Single sign-on via DWS Hub (OIDC authorization code + PKCE). Set SSO_ENABLED=true and fill in
# the client id the Hub admin assigned to this app (Hub Admin: sso_mode=oidc). The redirect URI
# must be registered in the Hub exactly as written here.
SSO_ENABLED=false
SSO_ISSUER=http://test-dwshub.kpndomain.com
SSO_CLIENT_ID=
SSO_REDIRECT_URI=http://test-it-inventory.kpndomain.com/auth/sso/callback
SSO_SCOPE=openid profile email

# Initial passwords for the two seeded accounts. Applied ONCE, on the very first start with
# an empty user table — editing them afterwards has no effect (use SEED_RESET_ADMIN below).
# admin@energi-up.com  /  bc.bontang@energi-up.com
#
# Do NOT use characters that .env treats specially:
#   $  starts an interpolation ($USER disappears; write $$ for a literal $)
#   #  after a space starts a comment
#   spaces or quotes at either end are easy to get wrong
# Letters, digits and @ ! _ - . % are all safe. The API refuses to start on a
# placeholder or anything shorter than 8 characters.
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_SITE_PASSWORD=CHANGE_ME

# Locked out? Set to true, restart the API once, then delete this line again.
# It resets ONLY the Super Admin password to SEED_ADMIN_PASSWORD and is written to the audit log.
# SEED_RESET_ADMIN=true

# Alert e-mail. Leave SMTP_HOST empty to disable sending (in-app notifications still work).
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=bc-inventory@energi-up.com
# Alert bodies name files, users and administrative actions, so the hop to the relay is
# encrypted by default. Set to false only if the relay genuinely does not offer STARTTLS.
SMTP_USE_TLS=true
# Only if the relay requires authentication.
SMTP_USER=
SMTP_PASSWORD=

# Leave as-is to start with an empty database. To load the sample extracts instead,
# uncomment the ../../docs mount in docker-compose.yml.
SAMPLE_DIR=/samples
