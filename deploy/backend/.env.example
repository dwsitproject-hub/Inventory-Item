# Copy to .env on 172.28.92.57:  cp .env.example .env && nano .env

# Database connection. Self-managed values shown; for ApsaraDB RDS set DB_HOST to the
# instance endpoint, DB_PORT to its port, and DB_USER/DB_NAME to the RDS account and database.
DB_PASSWORD=CHANGE_ME
DB_HOST=172.28.92.60
DB_PORT=5443
DB_USER=bcapp
DB_NAME=bcinventory
# Prefer = use TLS when the server offers it. Set to Require to insist on it.
DB_SSLMODE=Prefer

# JWT signing key — 32+ random characters. Changing it invalidates all sessions.
# Generate:  openssl rand -base64 48
JWT_KEY=CHANGE_ME

# Initial passwords for the two seeded accounts. Applied ONCE, on the very first start with
# an empty user table — editing them afterwards has no effect (use SEED_RESET_ADMIN below).
# admin@energi-up.com  /  bc.bontang@energi-up.com
#
# Do NOT use characters that .env treats specially:
#   $  starts an interpolation ($USER disappears; write $$ for a literal $)
#   #  after a space starts a comment
#   spaces or quotes at either end are easy to get wrong
# Letters, digits and @ ! _ - . % are all safe. The API refuses to start on a
# placeholder or anything shorter than 8 characters.
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_SITE_PASSWORD=CHANGE_ME

# Locked out? Set to true, restart the API once, then delete this line again.
# It resets ONLY the Super Admin password to SEED_ADMIN_PASSWORD and is written to the audit log.
# SEED_RESET_ADMIN=true

# Alert e-mail. Leave SMTP_HOST empty to disable sending (in-app notifications still work).
SMTP_HOST=
SMTP_PORT=25
SMTP_FROM=bc-inventory@energi-up.com

# Leave as-is to start with an empty database. To load the sample extracts instead,
# uncomment the ../../docs mount in docker-compose.yml.
SAMPLE_DIR=/samples
