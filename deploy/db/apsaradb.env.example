# ApsaraDB RDS target for the BC Inventory migration.
# Copy to apsaradb.env on 172.28.92.60 and fill in every value from the Alibaba Cloud
# console. The migration script refuses to run on an unset or placeholder value —
# a pasted placeholder is the first trap in the runbook.
#
#   cp apsaradb.env.example apsaradb.env && nano apsaradb.env && chmod 600 apsaradb.env

# Instance endpoint, e.g. pgm-xxxxxxxx.pg.rds.aliyuncs.com
RDS_HOST=
RDS_PORT=5432
# The database to restore into. Create it in the console first.
RDS_DB=bcinventory
# Privileged account for this database (the console's "Privileged Account", or an
# account with Owner rights on RDS_DB).
RDS_USER=
RDS_PW=

# Client image. MUST match the RDS engine's major version, never the source's.
# PostgreSQL 18 target -> postgres:18 · 17 -> postgres:17 · 16 -> postgres:16
PGCLIENT_IMAGE=postgres:18

# Source — the self-managed container on this host. Read from deploy/db/.env.
SRC_HOST=172.28.92.60
SRC_PORT=5443
SRC_DB=bcinventory
SRC_USER=bcapp
SRC_PW=
