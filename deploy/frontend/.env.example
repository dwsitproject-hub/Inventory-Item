# Copy to .env on 172.28.92.56:  cp .env.example .env

# Host port for the web tier. Keep 8088: port 80 on this server belongs to the host's own
# nginx, which fronts test-it-inventory.kpndomain.com and proxies here (see
# host-nginx-vhost.conf). Do not try to take port 80 — it would stop the other apps.
WEB_PORT=8088

# Interface to publish on.
#   0.0.0.0   = also reachable directly as http://172.28.92.56:8088 (handy while testing)
#   127.0.0.1 = reachable only through the host nginx; tighten to this once the vhost works,
#               and the 8088 security-group rule can then be removed
WEB_BIND=0.0.0.0
